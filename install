#!/bin/bash
# Bootstrap for this repo: latest ansible-core + Galaxy requirements.
# Runs BEFORE any playbook — installing ansible cannot be done from inside an
# ansible run (the running controller keeps its own version for the whole run).
# uv is used on both platforms instead of brew/apt, so the version is always
# current and identical on macOS and Linux.

set -euo pipefail

usage() {
  echo "Usage: $0 [-r]"
  echo "  -r  Install Ansible Roles and other requirements only"
  exit 1
}

# Function to install requirements
install_requirements() {
  export PATH="$HOME/.local/bin:$PATH"
  ansible-galaxy install -r requirements.yml --force
}

# Function to install latest ansible-core via uv (+ python-debian for the
# deb822_repository module the docker role uses; uv's isolated venv cannot
# see the system python3-debian package).
install_ansible() {
  # ~/.local/bin first: uv and ansible both live there (dotfiles/.zshrc has the
  # same line, but non-interactive shells such as this script don't read it).
  export PATH="$HOME/.local/bin:$PATH"

  if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found — installing via astral.sh..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
  fi

  if ! command -v uv >/dev/null 2>&1; then
    echo "uv installed to ~/.local/bin but not on PATH; add it and re-run:" >&2
    echo '  export PATH="$HOME/.local/bin:$PATH"' >&2
    exit 1
  fi

  echo "Installing/upgrading latest ansible-core via uv..."
  uv tool install --reinstall ansible-core --with python-debian

  if ! command -v ansible >/dev/null 2>&1; then
    echo "ansible installed but not on PATH; add ~/.local/bin and re-run:" >&2
    echo '  export PATH="$HOME/.local/bin:$PATH"' >&2
    exit 1
  fi
  ansible --version | head -1
}

# Parse command line arguments
while getopts ":r" option; do
  case "${option}" in
    r)
      install_requirements
      exit 0
      ;;
    *)
      usage
      ;;
  esac
done

# If no arguments are provided, run all commands
if [ ${OPTIND} -eq 1 ]; then
  install_ansible
  install_requirements
fi
